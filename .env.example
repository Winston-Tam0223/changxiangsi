# Supabase 配置（复制为 .env，填入你的真实值）
# 注意：SUPABASE_URL 只填基础域名（不要带 /rest/v1/）
SUPABASE_URL=https://mrpoqgwgmydhksdfpacb.supabase.co
# anon public key（或新版 Publishable key，sb_publishable_ 开头）
SUPABASE_ANON_KEY=请粘贴_你的_anon_public_key
# service_role secret（或新版 Secret key，sb_secret_ 开头；只放后端，严禁公开）
SUPABASE_SERVICE_ROLE_KEY=请粘贴_你的_service_role_secret
# 可选：管理员邮箱（默认 1757349561@qq.com）
ADMIN_EMAIL=1757349561@qq.com
